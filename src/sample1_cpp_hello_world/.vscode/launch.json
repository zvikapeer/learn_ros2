{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug hello_world_node",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/../../install/hello_world/lib/hello_world/hello_world_node",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "AMENT_PREFIX_PATH",
          "value": "/opt/ros/lyrical:${workspaceFolder}/../../install/hello_world"
        },
        {
          "name": "LD_LIBRARY_PATH",
          "value": "/opt/ros/lyrical/lib:${workspaceFolder}/../../install/hello_world/lib"
        }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "colcon: build (this package)",
      "miDebuggerPath": "/usr/bin/gdb"
    }
  ]
}

